  <footer class="footer">
    <div class="container">
      <div class="footer__inner">
        <div class="footer__top">
          <div class="footer__brand">
            <a href="{{ prefix }}index.html" class="footer__logo" aria-label="Get Lagos Now — back to top">
              <img src="{{ prefix }}{{ site.logoSrc }}" alt="Get Lagos Now" width="190" height="40" loading="lazy">
            </a>
            <p class="footer__tagline">{{ site.footerTagline | safe }}</p>
            <p class="footer__desc">{{ site.footerDesc }}</p>
            <p class="footer__loc"><span class="dot-red" aria-hidden="true"></span> {{ site.footerLoc }}</p>
            <ul class="socials" aria-label="Social media">
              {%- for social in navigation.socials %}
              <li><span class="social-placeholder" aria-label="{{ social.label }} (link to be confirmed)">{{ social.short }}</span></li>
              {%- endfor %}
            </ul>
          </div>

          <div class="footer__right">
            <div class="footer__cols">
              {%- for col in navigation.footerColumns %}
              <nav aria-label="{{ col.ariaLabel }}">
                <p class="footer__head">{{ col.head }}</p>
                <ul>
                  {%- for link in col.items %}
                  <li><a href="{{ prefix }}{{ link.href }}"{% if nav.footerCurrent and nav.footerCurrent[col.key] == link.href %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
                  {%- endfor %}
                </ul>
              </nav>
              {%- endfor %}
            </div>
{% include "components/newsletter-form.njk" %}
          </div>
        </div>

        <div class="footer__bottom">
          <p>&copy; <span id="year">2026</span> {{ site.legalEntity }}. All rights reserved.</p>
          <ul>
            {%- for link in navigation.legalRow %}
            <li><a href="{% if link.external %}{{ link.href }}{% else %}{{ prefix }}{{ link.href }}{% endif %}">{{ link.label }}</a></li>
            {%- endfor %}
          </ul>
          <p class="footer__credit">{{ footerCredit or site.footerCredit }}</p>
        </div>
      </div>
    </div>
  </footer>
