{# ============================================================================
   Reusable portfolio components for Get Lagos Now portfolio migration.
   These macros render the exact structures of the original category pages
   while pulling content from structured data in src/_data/portfolio.json.
   ========================================================================== #}

{# --------------------------------------------------------------------------
   01 Category hero — eyebrow, H1, intro text, optional scroll cue
   --------------------------------------------------------------------------}
{% macro portfolio_hero(hero) %}
<section class="portfolio-hero" aria-labelledby="portfolio-hero-title">
  <div class="container portfolio-hero__grid">
    <div class="portfolio-hero__content">
      {% if hero.eyebrow %}
        <p class="eyebrow portfolio-hero__eyebrow">{{ hero.eyebrow }}</p>
      {% endif %}
      <h1 id="portfolio-hero-title" class="portfolio-hero__title">{{ hero.title }}</h1>
      {% if hero.text %}
        <p class="portfolio-hero__text">{{ hero.text }}</p>
      {% endif %}
      {% if hero.scrollCue %}
        <a href="#featured" class="scroll-cue">
          <span class="scroll-cue__track" aria-hidden="true"><span class="scroll-cue__dot"></span></span>
          <span>Scroll to explore</span>
        </a>
      {% endif %}
    </div>
    <div class="portfolio-hero__visual">
      {% if hero.media %}
        <figure class="portfolio-hero__primary">
          <img src="{{ hero.media.src }}"
               {% if hero.media.fallback %}data-fallback="{{ hero.media.fallback }}"{% endif %}
               alt="{{ hero.media.alt }}"
               width="{{ hero.media.width }}" height="{{ hero.media.height }}" fetchpriority="high">
        </figure>
      {% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{# --------------------------------------------------------------------------
   02 Introduction — heading + supporting text
   --------------------------------------------------------------------------}
{% macro portfolio_intro(intro) %}
<section class="portfolio-intro section">
  <div class="container">
    <header class="portfolio-intro__head reveal">
      {% if intro.heading %}
        <h2 class="portfolio-intro__heading">{{ intro.heading }}</h2>
      {% endif %}
    </header>
    {% if intro.text %}
      <p class="portfolio-intro__text">{{ intro.text }}</p>
    {% endif %}
  </div>
</section>
{% endmacro %}

{# --------------------------------------------------------------------------
   03 Featured project showcase — one or more feature panels
   --------------------------------------------------------------------------}
{% macro portfolio_featured(featured) %}
<section class="feature section" id="featured" aria-labelledby="feature-title">
  <div class="container">
    {% for item in featured %}
      <article class="feature__panel reveal">
        <a class="feature__media" href="{{ item.ctaHref }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <img src="{{ item.media.src }}"
               {% if item.media.fallback %}data-fallback="{{ item.media.fallback }}"{% endif %}
               alt="{{ item.media.alt }}"
               width="{{ item.media.width }}" height="{{ item.media.height }}" loading="lazy">
          <span class="feature__tag">{{ item.tag }}</span>
        </a>
        <div class="feature__details">
          <p class="eyebrow">Featured project / {{ item.tag }}</p>
          <h2 id="feature-title" class="feature__client">{{ item.client }}</h2>
          <p class="feature__headline">{{ item.headline }}</p>
          <p class="feature__text">{{ item.text }}</p>
          <dl class="feature__meta">
            {% for m in item.meta %}
              <div><dt class="meta-label">{{ m.label }}</dt><dd>{% if m.linkText %}<a href="{{ m.value }}" class="meta-link" target="_blank" rel="noopener">{{ m.linkText }}</a>{% else %}{{ m.value }}{% endif %}</dd></div>
            {% endfor %}
          </dl>
          <a href="{{ item.ctaHref }}" class="btn btn--dark feature__cta" target="_blank" rel="noopener">
            <span>{{ item.ctaLabel }}<span class="sr-only"> (opens in a new tab)</span></span>
            <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"/></svg></span>
          </a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% endmacro %}

{# --------------------------------------------------------------------------
   04 Project image/info — reusable project card used by collections & rows
   --------------------------------------------------------------------------}
{% macro portfolio_project(item, variant="default") %}
{% set cls = "portfolio-project" %}
{% if variant == "pair" %}{% set cls = cls + " portfolio-project--pair" %}
{% elseif variant == "wide" %}{% set cls = cls + " portfolio-project--wide" %}
{% elseif variant == "pair--medium" %}{% set cls = cls + " portfolio-project--pair--medium" %}
{% elseif variant == "row" %}{% set cls = cls + " portfolio-project--row" %}
{% endif %}
<figure class="{{ cls }}">
  <a href="{{ item.href }}" class="portfolio-project__link">
    <img src="{{ item.image }}" alt="{{ item.alt }}" loading="lazy">
  </a>
  <figcaption class="portfolio-project__caption">
    <h3 class="portfolio-project__title"><a href="{{ item.href }}">{{ item.title }}</a></h3>
    {% if item.categories %}
      <p class="portfolio-project__cats">{{ item.categories }}</p>
    {% endif %}
  </figcaption>
</figure>
{% endmacro %}

{# --------------------------------------------------------------------------
   05 Additional project collection — pair / wide / pair--medium groupings
   --------------------------------------------------------------------------}
{% macro portfolio_collection(collection) %}
<section class="portfolio-collection section" aria-labelledby="collection-title">
  <div class="container">
    {% for group in collection %}
      {% if group.kind == "pair" %}
        <div class="portfolio-collection__pair reveal">
          {% for item in group.items %}
            {{ portfolio_project(item, "pair") }}
          {% endfor %}
        </div>
      {% elseif group.kind == "wide" %}
        <div class="portfolio-collection__wide reveal">
          {% for item in group.items %}
            {{ portfolio_project(item, "wide") }}
          {% endfor %}
        </div>
      {% elseif group.kind == "pair--medium" %}
        <div class="portfolio-collection__pair--medium reveal">
          {% for item in group.items %}
            {{ portfolio_project(item, "pair--medium") }}
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endmacro %}

{# --------------------------------------------------------------------------
   06 Category navigation / filter buttons — preserves filter labels & order
   --------------------------------------------------------------------------}
{% macro portfolio_nav(filters) %}
<div class="filter-bar reveal">
  <div class="filter-bar__scroller" id="workFilters" role="group" aria-label="Filter projects by category">
    {% for f in filters %}
      <button type="button" class="filter-btn" data-filter="{{ f.slug }}" aria-pressed="{{ 'true' if f.active else 'false' }}" aria-controls="workGrid">{{ f.label }}</button>
    {% endfor %}
  </div>
  {% if filters|length %}
    <p class="filter-bar__count" id="workCount" role="status" aria-live="polite">Showing {{ filters|length }} projects</p>
  {% endif %}
</div>
{% endmacro %}

{# --------------------------------------------------------------------------
   07 Testimonial section — quote + author + org + logo
   --------------------------------------------------------------------------}
{% macro portfolio_testimonial(t) %}
<section class="portfolio-testimonial section" aria-labelledby="testimonial-title">
  <div class="container">
    <header class="section-head section-head--center reveal">
      {% if t.heading %}
        <p class="eyebrow">{{ t.heading }}</p>
      {% endif %}
      <h2 id="testimonial-title" class="h2">{{ t.title }}</h2>
    </header>
    <div class="wt reveal">
      <figure class="wt__quote">
        <span class="wt__mark" aria-hidden="true">“</span>
        <blockquote><p>{{ t.quote }}</p></blockquote>
        <figcaption><strong>{{ t.author }}</strong><span>{{ t.org }}</span></figcaption>
      </figure>
      {% if t.media %}
        <figure class="wt__plate">
          <img src="{{ t.media.src }}" alt="{{ t.media.alt }}" loading="lazy">
          {% if t.media.captionLine1 or t.media.captionLine2 %}
            <figcaption class="wt__plate-bar"><span>{{ t.media.captionLine1 }}</span><span>{{ t.media.captionLine2 }}</span></figcaption>
          {% endif %}
        </figure>
      {% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{# --------------------------------------------------------------------------
   08 Shared final CTA — mirrors cta-banner.njk structure with portfolio classes
   --------------------------------------------------------------------------}
{% macro portfolio_cta(cta) %}
<section class="cta{{ cta.sectionClass }}" aria-labelledby="{{ cta.titleId }}">
  <div class="container">
    <div class="cta__banner{{ cta.bannerClass if cta.bannerClass else '' }}">
      {% if cta.wrapper %}
      <div{{ ' class="' ~ cta.wrapperClass ~ '"' if cta.wrapperClass else '' }}>
        <h2 id="{{ cta.titleId }}" class="cta__title">{{ cta.title }}</h2>
        <p class="{{ cta.lineClass }}">{{ cta.line }}</p>
      </div>
      {% else %}
      <h2 id="{{ cta.titleId }}" class="cta__title">{{ cta.title }}</h2>
      {% endif %}
      <a href="{% if cta.href[0] != '#' %}{{ prefix }}{% endif %}{{ cta.href }}" class="cta__action">
        <span class="cta__action-mark" aria-hidden="true">
          <img src="https://images.pexels.com/photos/16752907/pexels-photo-16752907.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop" alt="" loading="lazy">
        </span>
        <span class="cta__action-text">
          <strong>{{ cta.strong }}</strong>
          <span>{{ cta.sub }}</span>
        </span>
        <span class="sq-btn sq-btn--red" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
      </a>
    </div>
  </div>
</section>
{% endmacro %}
