            <a href="#featured-partnerships" class="btn btn--dark"><span>Explore Projects</span><span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 3v10M4 9l4 4 4-4"/></svg></span></a>
          </div>
        </div>
