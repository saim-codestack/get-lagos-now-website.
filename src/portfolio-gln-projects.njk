    "style.css",
    "responsive.css",
    "portfolio-category.css",
    "portfolio-complete.css"
  ],
  "js": [
    "main.js",
    "portfolio-library.js"
  ],
  "robots": null,
  "themeColor": true,
  "preconnectFonts": true,
  "preconnectSource": false,
  "nav": {
    "dropdownCurrent": "portfolio-gln-projects.html",
    "footerCurrent": {
      "services": "portfolio-gln-projects.html"
