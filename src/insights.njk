---json
{
  "layout": "layouts/base.njk",
  "title": "Insights & Journal | Get Lagos Now",
  "description": "Explore insights from Get Lagos Now on web design, digital accessibility, SEO, branding, marketing, and meaningful digital innovation.",
  "dataPage": "insights",
  "css": [
    "style.css",
    "responsive.css",
    "insights.css",
    "articles.css"
  ],
  "js": [
    "main.js",
    "blog-library.js"
  ],
  "robots": null,
  "themeColor": true,
  "preconnectFonts": true,
  "preconnectSource": true,
  "navComment": null,
  "footerComment": null,
  "footerCredit": "Editorial photography via Pexels. Project imagery © respective clients.",
  "nav": {
    "desktop": "insights",
    "mobile": "insights",
    "mobileClass": true,
    "footerCurrent": {
      "explore": "insights.html"
    }
  },
  "cta": {
    "sectionClass": "journal-cta",
    "titleId": "cta-title",
    "title": "Let's Talk.",
    "wrapper": "plain",
    "lineClass": "journal-cta__line",
    "line": "Great ideas deserve great execution. Let's create something meaningful together.",
    "href": "contact.html#contact-form",
    "strong": "Start a project",
    "sub": "Portland, Oregon"
  }
}
---

    <!-- The shared inner-page hero retains the Our Work image geometry. -->
    <section class="inner-page-hero" aria-labelledby="journal-title">
      <div class="container inner-page-hero__grid">
        <div class="inner-page-hero__content reveal">
          <p class="eyebrow">The Lagos Journal</p>
          <h1 id="journal-title" class="inner-page-hero__title">Ideas shaping<br>what's next.</h1>
          <p class="inner-page-hero__text">Explore fresh perspectives on design, technology, digital marketing, and meaningful innovation. Thoughtful ideas and practical insights to help your organization move forward.</p>
          <div class="inner-page-hero__cta">
            <a href="#featured-story" class="btn btn--dark">
              <span>Explore Articles</span>
              <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 3v10M4 9l4 4 4-4"/></svg></span>
            </a>
          </div>
        </div>
        <div class="inner-page-hero__visual reveal">
          <figure class="inner-page-hero__primary">
            <img src="https://images.pexels.com/photos/8085942/pexels-photo-8085942.jpeg?auto=compress&cs=tinysrgb&w=1400"
                 alt="Editorial workspace with research documents and a laptop" width="1400" height="933" fetchpriority="high" decoding="async">
          </figure>
          <figure class="inner-page-hero__detail">
            <img src="https://images.pexels.com/photos/225767/pexels-photo-225767.jpeg?auto=compress&cs=tinysrgb&w=700"
                 alt="Quiet desk with paper, pen, and a laptop" width="700" height="467" decoding="async">
          </figure>
        </div>
      </div>
    </section>

    {% set ordered = articles | sortBy("sequence") %}
    <section class="journal-feature section" id="featured-story" aria-labelledby="featured-story-title">
      <div class="container">
        <p class="eyebrow reveal">Editor's pick / Featured article</p>
        {% for a in ordered %}
          {% if a.inFeatured %}
        <article class="journal-feature__grid reveal">
            <a class="journal-feature__media" href="articles/{{ a.slug }}.html" rel="noopener" aria-label="{{ a.heroAriaLabel | safe }}">
            <img src="{{ a.heroImage }}" alt="{{ a.heroAlt | safe }}" width="{{ a.heroWidth }}" height="{{ a.heroHeight }}" loading="lazy" decoding="async">
          </a>
          <div class="journal-feature__copy">
            <div class="journal-feature__meta"><span>{{ a.heroMeta | safe }}</span><time datetime="{{ a.heroDate }}">{{ a.heroDateDisplay }}</time></div>
            <h2 id="featured-story-title">{{ a.heroTitle | safe }}</h2>
            <p>{{ a.heroExcerpt | safe }}</p>
            <a href="articles/{{ a.slug }}.html" class="btn btn--dark" rel="noopener">
              <span>Read Article<span class="sr-only"></span></span>
              <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"/></svg></span>
            </a>
          </div>
        </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="journal-topics section" id="topics" aria-labelledby="topics-title">
      <div class="container">
        <div class="journal-topics__head reveal">
          <p class="eyebrow">Explore by topic</p>
          <h2 id="topics-title" class="h2">Find what interests you.</h2>
        </div>
        <nav class="journal-topics__nav" aria-label="Filter journal articles">
          <div class="journal-topics__scroll" id="blogLibraryFilters" role="group" aria-label="Article topics">
            <button type="button" data-topic="all" aria-pressed="true">All Articles</button>
            <button type="button" data-topic="web-design" aria-pressed="false">Web Design</button>
            <button type="button" data-topic="accessibility" aria-pressed="false">Accessibility</button>
            <button type="button" data-topic="seo-ai" aria-pressed="false">SEO &amp; AI</button>
            <button type="button" data-topic="marketing" aria-pressed="false">Marketing</button>
            <button type="button" data-topic="branding" aria-pressed="false">Branding</button><button type="button" data-topic="client-showcase" aria-pressed="false">Client Showcase</button><button type="button" data-topic="community" aria-pressed="false">Community &amp; Sustainability</button>
          </div>
        </nav>
        <p class="journal-topics__count" id="blogLibraryCount" role="status" aria-live="polite">Browse all 49 original publication records below.</p>
      </div>
    </section>

    <section class="journal-latest section" id="latest" aria-labelledby="latest-title">
      <div class="container">
        <header class="journal-section-head reveal">
          <div><p class="eyebrow">From the journal</p><h2 id="latest-title" class="h2">Fresh thinking.<br>Useful perspectives.</h2></div>
          <p>Ideas and practical knowledge from the intersection of creativity, technology, and thoughtful business growth.</p>
        </header>
        <div class="journal-grid" id="blogLibraryGrid" aria-live="off">
        {% for a in ordered %}
          {% if a.isCard %}
          <article class="journal-card" data-article-id="{{ a.archiveDataId }}" data-topics="{{ a.archiveTopics }}">
            <a class="journal-card__image" href="articles/{{ a.slug }}.html" aria-label="Read {{ a.archiveTitle | safe }}">
              <img src="{{ a.archiveImage }}" alt="{{ a.archiveAlt | safe }}" width="{{ a.archiveWidth }}" height="{{ a.archiveHeight }}" loading="lazy" decoding="async">
            </a>
            <div class="journal-card__meta"><span>{{ a.archiveMeta | safe }}</span><time datetime="{{ a.archiveDate }}">{{ a.archiveDate }}</time></div>
            <h3 class="journal-card__title"><a href="articles/{{ a.slug }}.html">{{ a.archiveTitle | safe }}</a><span class="journal-card__arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12l8-8M4 4h8v8"/></svg></span></h3>
            <p class="journal-card__excerpt">{{ a.archiveExcerpt | safe }}</p>
          </article>
          {% endif %}
        {% endfor %}
        </div>
      </div>
    </section>

    <section class="journal-perspective" aria-labelledby="perspective-title">
      <div class="container journal-perspective__grid">
        <div class="journal-perspective__copy reveal">
          <p class="eyebrow eyebrow--light">A closer look / Digital inclusion</p>
          <h2 id="perspective-title">A better web<br>starts with everyone.</h2>
          <p>Accessibility is about creating digital experiences that more people can navigate, understand, and use. Thoughtful inclusive design helps organizations connect with broader audiences.</p>
          <div class="journal-perspective__article"><span>Featured perspective / Accessibility</span><time datetime="2024-12-16">Originally December 16, 2024</time><span>Updated October 2025</span></div>
          <h3>How Important Are ADA Compliant Websites?</h3>
          <a href="articles/ada-compliant-website.html" class="link-arrow link-arrow--light" rel="noopener">Read the Perspective <span class="link-arrow__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a>
        </div>
        <figure class="journal-perspective__media reveal">
          <img src="assets/images/shared/smile-and-coffee-1024x623.png" alt="Inclusive design editorial photograph published with Get Lagos Now's accessibility article" width="1024" height="623" loading="lazy" decoding="async">
          <figcaption>From the Get Lagos Now accessibility perspective</figcaption>
        </figure>
      </div>
    </section>

    <section class="journal-more section" id="more-articles" aria-labelledby="more-title">
      <div class="container">
        <header class="journal-section-head reveal">
          <div><p class="eyebrow">Keep exploring</p><h2 id="more-title" class="h2">More ideas to explore.</h2></div>
          <p>From practical marketing knowledge to thoughtful digital strategies, there's always something new to discover.</p>
        </header>
        <div class="journal-list" id="blogLibraryList">
        {% for a in ordered %}
          {% if not a.isCard %}
          <article class="journal-row" data-article-id="{{ a.archiveDataId }}" data-topics="{{ a.archiveTopics }}">
            <div class="journal-row__meta"><time datetime="{{ a.archiveDate }}">{{ a.archiveDate }}</time><span>{{ a.archiveMeta | safe }}</span></div>
            <h3><a href="articles/{{ a.slug }}.html">{{ a.archiveTitle | safe }}</a></h3>
            <span class="journal-row__arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12l8-8M4 4h8v8"/></svg></span>
          </article>
          {% endif %}
        {% endfor %}
        </div>
        <p class="journal-empty" id="journalEmpty" hidden>No more articles in this topic yet. Select another topic to keep exploring.</p>
        <div class="journal-more__foot"><button type="button" class="btn btn--dark" id="blogLibraryLoad" hidden><span>Load More Articles</span><span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></button></div>
        <noscript><p>All article links are listed above. JavaScript adds topic filtering and Load More.</p></noscript>
      </div>
    </section>
